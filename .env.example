# LiteRT (Google AI Edge, Gemma 4 E4B via LiteRT-LM). When set, /api/gemma-chat uses this instead of LM Studio.
# Terminal A: python scripts/litert_openai_server.py
# Terminal B: pnpm dev — copy this file to .env.local and uncomment:
# LITERT_OPENAI_BASE_URL=http://127.0.0.1:8787/v1

# LM Studio (OpenAI-compatible). Used only if LITERT_OPENAI_BASE_URL is unset.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
