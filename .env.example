# LiteRT (Gemma 4 E4B via LiteRT-LM) — required for /simulation live inference
# Terminal A: python scripts/litert_openai_server.py
# Terminal B: pnpm dev — copy to .env.local and uncomment:
LITERT_OPENAI_BASE_URL=http://127.0.0.1:8787/v1

# Optional: path to .litertlm weights (default: models/gemma-4-E4B-it.litertlm)
# LITERT_MODEL_PATH=/path/to/gemma-4-E4B-it.litertlm

# Optional: cloud Gemma 4 for timeline_generator / arc_core API mode
# GEMMA_API_KEY=your_google_ai_studio_key
# GEMMA_API_MODEL=gemma-4-26b-a4b-it
